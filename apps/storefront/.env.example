# Salin file ini menjadi .env.local lalu isi nilainya.
# Di Vercel, isi ketiganya lewat Project Settings -> Environment Variables.

# Dari Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — HANYA untuk Route Handler di server (dashboard mitra
# & admin). JANGAN pernah diberi prefix NEXT_PUBLIC_ dan jangan pernah
# dikirim ke kode frontend/client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL lintas-workspace — dibaca lewat packages/shared/tokens.js, jangan
# pernah hardcode domain ini di kode. Boleh dikosongkan di lokal (fallback
# ke localhost otomatis); WAJIB diisi di Vercel produksi.
NEXT_PUBLIC_SITE_URL=https://kalamekar.id
NEXT_PUBLIC_BUILDER_URL=https://kalamekardemo.vercel.app
NEXT_PUBLIC_APP_URL=https://kalamekardemo-app.vercel.app
