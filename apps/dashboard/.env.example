# Salin file ini menjadi .env.local lalu isi nilainya.
# Di Vercel, isi semuanya lewat Project Settings -> Environment Variables
# (project Vercel KETIGA, Root Directory = apps/dashboard).

# Dari Supabase: Project Settings -> API (sama dengan project storefront/builder)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — HANYA untuk Route Handler di server. JANGAN pernah
# diberi prefix NEXT_PUBLIC_ dan jangan pernah dikirim ke kode frontend/client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL lintas-workspace — jangan pernah hardcode di kode, selalu lewat env.
NEXT_PUBLIC_STOREFRONT_URL=https://kalamekardemo-store.vercel.app
NEXT_PUBLIC_BUILDER_URL=https://kalamekardemo.vercel.app
NEXT_PUBLIC_APP_URL=https://kalamekardemo-app.vercel.app

# Nomor WhatsApp support platform (beda dari nomor WA floris)
NEXT_PUBLIC_WA_SUPPORT_NUMBER=6287720742631
